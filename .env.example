# Copy this file to .env and fill in your own values.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxx-placeholder
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_EXTRACT_TEMPERATURE=0.0
SERVER_PORT=8080

# Dify Service API (dataset scope)
DIFY_BASE_URL=http://localhost/v1
DIFY_DATASET_API_KEY=
DIFY_DEFAULT_DATASET_ID=
DIFY_DATASET_A_ID=
DIFY_DATASET_B_ID=
DIFY_POLL_INTERVAL_MS=2000
DIFY_POLL_TIMEOUT_MS=180000
DIFY_CONNECT_TIMEOUT_SECONDS=10
DIFY_REQUEST_TIMEOUT_SECONDS=60
DIFY_MAX_TOKENS=800
DIFY_CHUNK_OVERLAP=100

# Dify Service API (application scope; separate keys for A/B chatflows)
# Never commit real values. DIFY_APP_API_KEY points to the B application.
DIFY_APP_API_KEY=
DIFY_APP_API_KEY_A=
DIFY_CHAT_TIMEOUT_SECONDS=120
